# Copy to .env for local development. Never commit real values.
ENVIRONMENT=local            # local | staging | production (non-local enforces required secrets)
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000     # public URL of THIS API (used for the Jira OAuth callback)
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (Neon in production). Use the *pooled* connection string. ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/assistant


# --- Google sign-in (Workspace) ---
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=yourcompany.com     # comma separated
ADMIN_EMAILS=you@yourcompany.com          # comma separated; become admins on first login

# --- Secrets ---
SESSION_SECRET=                            # openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                      # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MCP_SHARED_SECRET=                         # openssl rand -hex 32 (same value for api and mcp services)
METRICS_TOKEN=                             # optional; protects /metrics

# --- Gemini ---
GEMINI_API_KEY=
MODEL_SMALL=gemini-3.5-flash-lite
MODEL_FRONTIER=gemini-3.5-flash

# --- Jira (Atlassian OAuth 2.0 3LO app) ---
JIRA_MCP_URL=http://localhost:8100/mcp
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# --- Optional fallback model provider (OpenAI-compatible). Used only if Gemini fails. ---
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL_SMALL=openai/gpt-oss-20b
FALLBACK_MODEL_FRONTIER=openai/gpt-oss-120b

# LLM_PREFER_FALLBACK=true   # answer with the OpenAI-compatible provider first (lower latency)

# open = anyone can sign up (self-serve workspaces); restricted = allowlist + invites only
SIGNUP_MODE=open
